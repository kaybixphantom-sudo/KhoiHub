    local lastTool = 0
    local function ToolFarm()
        if not FLAGS.ToolFarm then return end
        if tick() - lastTool < 0.15 then return end
        lastTool = tick()
        local char = GetChar()
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return end
        local equipped = nil
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("Tool") then equipped = v; break end
        end
        if not equipped then
            local bp = LP:FindFirstChild("Backpack")
            if bp then
                for _, v in ipairs(bp:GetChildren()) do
                    if v:IsA("Tool") then
                        pcall(function() hum:EquipTool(v) end)
                        return
                    end
                end
            end
            return
        end
        pcall(function() equipped:Activate() end)
    end

    local lastPunch = 0
    local function PunchFarm()
        if not FLAGS.PunchFarm then return end
        if tick() - lastPunch < 0.1 then return end
        lastPunch = tick()
        local hum = GetHum()
        if not hum or hum.Health <= 0 then return end
        local m = GetMuscleEvent()
        if not m then return end
        Fire(m, "punch", "leftHand")
        Fire(m, "punch", "rightHand")
    end

    local lastKill = 0
    local function KillAura()
        if not (FLAGS.KillAura or FLAGS.KillList or FLAGS.KillEveryone
        or FLAGS.FarmEvilKarma or FLAGS.FarmGoodKarma) then return end
        if tick() - lastKill < 0.08 then return end
        lastKill = tick()
        local h = GetHRP()
        if not h then return end
        local m = GetMuscleEvent()
        if not m then return end
        if FLAGS.KillEveryone then
            Fire(m, "punch", "leftHand")
            Fire(m, "punch", "rightHand")
            return
        end
        for _, p in ipairs(PL:GetPlayers()) do
            if p ~= LP and p.Character then
                local skip = false
                if FLAGS.WhitelistFriends and IsFriend(p) then skip = true end
                if not skip then
                    local th = p.Character:FindFirstChild("HumanoidRootPart")
                    local hm = p.Character:FindFirstChildOfClass("Humanoid")
                    if th and hm and hm.Health > 0 then
                        local d = (h.Position - th.Position).Magnitude
                        local should = false
                        if FLAGS.KillList and d < 20 then should = true end
                        if FLAGS.KillAura and d < FLAGS.Range then should = true end
                        if (FLAGS.FarmEvilKarma or FLAGS.FarmGoodKarma) and d < 30 then should = true end
                        if should then
                            Fire(m, "punch", "leftHand")
                            Fire(m, "punch", "rightHand")
                            break
                        end
                    end
                end
            end
        end
    end

