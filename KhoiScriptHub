                        tl.Text = t..": "..tostring(val)
                        FLAGS[d] = val
                        if cb then pcall(cb, val) end
                    end

                    track(sb.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                            dragging = true
                            update(input)
                        end
                    end))
                    track(sb.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                            dragging = false
                        end
                    end))
                    track(UIS.InputChanged:Connect(function(input)
                        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch) then
                            update(input)
                        end
                    end))
                end

                function so.TextBox(t, d, default, cb)
                    local c = so.CC2(60)
                    local tl = Instance.new("TextLabel", c)
                    tl.Size = UDim2.new(0.7, 0, 0, 20)
                    tl.Position = UDim2.new(0, 12, 0, 5)
                    tl.BackgroundTransparency = 1
                    tl.Text = t
                    tl.TextColor3 = Color3.fromRGB(255, 255, 255)
                    tl.Font = Enum.Font.Gotham
                    tl.TextSize = 13
                    tl.TextXAlignment = Enum.TextXAlignment.Left

                    local tb = Instance.new("TextBox", c)
                    tb.Size = UDim2.new(1, -24, 0, 26)
                    tb.Position = UDim2.new(0, 12, 0, 28)
                    tb.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
                    tb.TextColor3 = Color3.fromRGB(255, 255, 255)
                    tb.Text = tostring(FLAGS[d] or default or "")
                    tb.Font = Enum.Font.Gotham
                    tb.TextSize = 13
                    tb.BorderSizePixel = 0
                    tb.ClearTextOnFocus = false
                    Instance.new("UICorner", tb).CornerRadius = UDim.new(0, 6)

                    if FLAGS[d] == nil then FLAGS[d] = default end
                    track(tb.FocusLost:Connect(function()
                        FLAGS[d] = tb.Text
                        if cb then pcall(cb, tb.Text) end
                    end))
                end

                function so.Dropdown(t, d, options, default, cb)
                    local c = so.CC2(60)
                    c.ZIndex = 5

                    local tl = Instance.new("TextLabel", c)
                    tl.Size = UDim2.new(0.7, 0, 0, 20)
                    tl.Position = UDim2.new(0, 12, 0, 5)
                    tl.BackgroundTransparency = 1
                    tl.Text = t
                    tl.TextColor3 = Color3.fromRGB(255, 255, 255)
                    tl.Font = Enum.Font.Gotham
                    tl.TextSize = 13
                    tl.TextXAlignment = Enum.TextXAlignment.Left
                    tl.ZIndex = 6

                    local selected = FLAGS[d] or default or options[1] or ""
                    FLAGS[d] = selected

                    local db = Instance.new("TextButton", c)
                    db.Size = UDim2.new(1, -24, 0, 26)
                    db.Position = UDim2.new(0, 12, 0, 28)
                    db.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
                    db.TextColor3 = Color3.fromRGB(255, 255, 255)
                    db.Text = selected
                    db.Font = Enum.Font.Gotham
                    db.TextSize = 13
                    db.BorderSizePixel = 0
                    db.ZIndex = 6
                    Instance.new("UICorner", db).CornerRadius = UDim.new(0, 6)

                    local open = false

                    local list = Instance.new("Frame", Main)
                    list.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
                    list.BorderSizePixel = 0
                    list.Visible = false
                    list.ZIndex = 100
                    list.ClipsDescendants = false
                    Instance.new("UICorner", list).CornerRadius = UDim.new(0, 6)
                    local listStroke = Instance.new("UIStroke", list)
                    listStroke.Color = Color3.fromRGB(255, 0, 0)
                    listStroke.Thickness = 1

                    local ll = Instance.new("UIListLayout", list)
                    ll.SortOrder = Enum.SortOrder.LayoutOrder

                    for _, opt in ipairs(options) do
                        local ob = Instance.new("TextButton", list)
                        ob.Size = UDim2.new(1, 0, 0, 24)
                        ob.BackgroundTransparency = 1
                        ob.TextColor3 = Color3.fromRGB(255, 255, 255)
                        ob.Text = opt
                        ob.Font = Enum.Font.Gotham
                        ob.TextSize = 12
                        ob.BorderSizePixel = 0
                        ob.ZIndex = 101
                        track(ob.MouseButton1Click:Connect(function()
                            selected = opt
                            db.Text = opt
                            FLAGS[d] = opt
                            list.Visible = false
                            open = false
                            if cb then pcall(cb, opt) end
                        end))
                    end

                    track(db.MouseButton1Click:Connect(function()
                        open = not open
                        if open then
                            list.Size = UDim2.new(0, db.AbsoluteSize.X, 0, #options * 24)
                            list.Position = UDim2.new(
                                0, db.AbsolutePosition.X - Main.AbsolutePosition.X,
                                0, db.AbsolutePosition.Y - Main.AbsolutePosition.Y + db.AbsoluteSize.Y + 2
                            )
                        end
                        list.Visible = open
                    end))
                end

                return so
            end

            return tab
        end

