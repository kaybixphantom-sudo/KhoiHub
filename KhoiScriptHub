    local function EnableFPSBoost()
        if _fpsEnabled then return end
        _fpsEnabled = true
        pcall(function()
            _fpsOriginals.GlobalShadows = LIGHT.GlobalShadows
            _fpsOriginals.FogEnd = LIGHT.FogEnd
            _fpsOriginals.Brightness = LIGHT.Brightness

            LIGHT.GlobalShadows = false
            LIGHT.FogEnd = 100000
            LIGHT.Brightness = 2

            for _, v in ipairs(LIGHT:GetChildren()) do
                if v:IsA("Atmosphere") or v:IsA("Clouds") then
                    table.insert(_fpsOriginals.HiddenObjects, v)
                    v.Parent = nil
                end
            end
            for _, v in ipairs(LIGHT:GetChildren()) do
                if v:IsA("PostEffect") then
                    table.insert(_fpsOriginals.DisabledParts, {obj=v, prop="Enabled", val=v.Enabled})
                    v.Enabled = false
                end
            end
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("ParticleEmitter") or v:IsA("Trail")
                or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
                    table.insert(_fpsOriginals.DisabledParts, {obj=v, prop="Enabled", val=v.Enabled})
                    v.Enabled = false
                end
            end
        end)
    end

    local function DisableFPSBoost()
        if not _fpsEnabled then return end
        _fpsEnabled = false
        pcall(function()
            if _fpsOriginals.GlobalShadows ~= nil then
                LIGHT.GlobalShadows = _fpsOriginals.GlobalShadows
            end
            if _fpsOriginals.FogEnd ~= nil then
                LIGHT.FogEnd = _fpsOriginals.FogEnd
            end
            if _fpsOriginals.Brightness ~= nil and not FLAGS.FullBright then
                LIGHT.Brightness = _fpsOriginals.Brightness
            end

            for _, v in ipairs(_fpsOriginals.HiddenObjects) do
                pcall(function()
                    if v and v.Parent == nil then v.Parent = LIGHT end
                end)
            end
            for _, entry in ipairs(_fpsOriginals.DisabledParts) do
                pcall(function()
                    if entry.obj and entry.obj.Parent ~= nil then
                        entry.obj[entry.prop] = entry.val
                    end
                end)
            end
            _fpsOriginals.HiddenObjects = {}
            _fpsOriginals.DisabledParts = {}
        end)
    end

