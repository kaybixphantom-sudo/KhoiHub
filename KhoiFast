local function MakeDraggable(frame)
local dragging = false
local startPos, startFramePos
track(frame.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1
or input.UserInputType == Enum.UserInputType.Touch then
dragging = true
startPos = input.Position
startFramePos = frame.Position
end
end))
track(frame.InputEnded:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1
or input.UserInputType == Enum.UserInputType.Touch then
dragging = false
end
end))
track(UIS.InputChanged:Connect(function(input)
if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
or input.UserInputType == Enum.UserInputType.Touch) then
local delta = input.Position - startPos
frame.Position = UDim2.new(
startFramePos.X.Scale, startFramePos.X.Offset + delta.X,
startFramePos.Y.Scale, startFramePos.Y.Offset + delta.Y
)
end
end))
end
local _fpsOriginals = { HiddenObjects = {}, DisabledParts = {} }
local _fpsEnabled = false
local function EnableAntiLag()
if _fpsEnabled then return end
_fpsEnabled = true
pcall(function()
_fpsOriginals.GlobalShadows = LIGHT.GlobalShadows
_fpsOriginals.FogEnd = LIGHT.FogEnd
_fpsOriginals.Brightness = LIGHT.Brightness
LIGHT.GlobalShadows = false
LIGHT.FogEnd = 100000
LIGHT.Brightness = 2
for _, v in ipairs(LIGHT:GetChildren()) do
if v:IsA("Atmosphere") or v:IsA("Clouds") then
table.insert(_fpsOriginals.HiddenObjects, v)
v.Parent = nil
end
end
for _, v in ipairs(LIGHT:GetChildren()) do
if v:IsA("PostEffect") then
table.insert(_fpsOriginals.DisabledParts, {obj=v, prop="Enabled", val=v.Enabled})
v.Enabled = false
end
end
for _, v in ipairs(workspace:GetDescendants()) do
if v:IsA("ParticleEmitter") or v:IsA("Trail")
or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
table.insert(_fpsOriginals.DisabledParts, {obj=v, prop="Enabled", val=v.Enabled})
v.Enabled = false
end
end
end)
end
local function DisableAntiLag()
if not _fpsEnabled then return end
_fpsEnabled = false
pcall(function()
if _fpsOriginals.GlobalShadows ~= nil then
LIGHT.GlobalShadows = _fpsOriginals.GlobalShadows
end
if _fpsOriginals.FogEnd ~= nil then
LIGHT.FogEnd = _fpsOriginals.FogEnd
end
if _fpsOriginals.Brightness ~= nil then
LIGHT.Brightness = _fpsOriginals.Brightness
end
for _, v in ipairs(_fpsOriginals.HiddenObjects) do
pcall(function()
if v and v.Parent == nil then v.Parent = LIGHT end
end)
end
for _, entry in ipairs(_fpsOriginals.DisabledParts) do
pcall(function()
if entry.obj and entry.obj.Parent ~= nil then
entry.obj[entry.prop] = entry.val
end
end)
end
_fpsOriginals.HiddenObjects = {}
_fpsOriginals.DisabledParts = {}
end)
end
