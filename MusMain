function so.Slider(t,d,mn,mx,default,cb)
local c=so.CC2(55)
local tl=Instance.new("TextLabel",c)
tl.Size=UDim2.new(0.7,0,0,20); tl.Position=UDim2.new(0,12,0,5)
tl.BackgroundTransparency=1; tl.TextColor3=Color3.new(1,1,1)
tl.Font=Enum.Font.Gotham; tl.TextSize=13
tl.TextXAlignment=Enum.TextXAlignment.Left
local sb=Instance.new("TextButton",c)
sb.Size=UDim2.new(1,-24,0,16); sb.Position=UDim2.new(0,12,0,30)
sb.BackgroundColor3=Color3.new(0.24,0.24,0.24); sb.Text=""; sb.BorderSizePixel=0
sb.AutoButtonColor=false
Instance.new("UICorner",sb).CornerRadius=UDim.new(0,8)
local val=tonumber(F[d]) or default
if val<mn then val=mn end
if val>mx then val=mx end
F[d]=val
local rel=math.clamp((val-mn)/(mx-mn),0,1)
local fill=Instance.new("Frame",sb)
fill.Size=UDim2.new(rel,0,1,0); fill.BackgroundColor3=Color3.new(1,0,0)
fill.BorderSizePixel=0
Instance.new("UICorner",fill).CornerRadius=UDim.new(0,8)
tl.Text=t..": "..tostring(val)
if cb then pcall(cb,val) end
local sdrag=false
local function upd(inp)
local r=math.clamp((inp.Position.X-sb.AbsolutePosition.X)/sb.AbsoluteSize.X,0,1)
val=math.floor(mn+(mx-mn)*r+0.5)
fill.Size=UDim2.new(r,0,1,0); tl.Text=t..": "..tostring(val)
F[d]=val
if cb then pcall(cb,val) end
end
track(sb.InputBegan:Connect(function(inp)
if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
sdrag=true; upd(inp)
end
end))
track(sb.InputEnded:Connect(function(inp)
if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then sdrag=false end
end))
track(UIS.InputChanged:Connect(function(inp)
if sdrag and (inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch) then upd(inp) end
end))
end
