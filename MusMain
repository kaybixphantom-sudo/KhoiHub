local function DeepFind(p,n)
local f=p:FindFirstChild(n)
if f then return f end
for _,v in pairs(p:GetDescendants()) do
if v.Name==n then return v end
end
end
local cache={}
local function Resolve(key,names)
if cache[key] and cache[key].Parent then return cache[key] end
local r=game:GetService("ReplicatedStorage"):FindFirstChild("rEvents")
if r then
for _,n in ipairs(names) do
local f=r:FindFirstChild(n)
if f then cache[key]=f; return f end
end
end
for _,n in ipairs(names) do
local f=DeepFind(game:GetService("ReplicatedStorage"),n)
if f then cache[key]=f; return f end
end
end
local function GM() return Resolve("m",{"muscleEvent","MuscleEvent","Muscle"}) end
local function GR() return Resolve("r",{"rebirthRemote","RebirthRemote","rebirthEvent"}) end
local function GW() return Resolve("w",{"spinWheelEvent","fortuneWheelEvent","SpinWheel"}) end
local function GC() return Resolve("c",{"openCrystalRemote","crystalEvent","openCrystal"}) end
local function GS() return Resolve("s",{"sellAllEvent","sellEvent","sellAllRemote","sellPetEvent"}) end
local function GU() return Resolve("u",{"upgradeEvent","upgradeRemote","upgradeStatEvent","upgrade"}) end
local function GetChar() return LP.Character end
local function GetHRP() local c=GetChar(); return c and c:FindFirstChild("HumanoidRootPart") end
local function GetHum() local c=GetChar(); return c and c:FindFirstChildOfClass("Humanoid") end
local function Fire(r,...)
if not r then return end
local a={...}
pcall(function()
if r:IsA("RemoteFunction") then r:InvokeServer(table.unpack(a))
else r:FireServer(table.unpack(a)) end
end)
end
